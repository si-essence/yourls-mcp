# YOURLS origin. http or https, no userinfo, query, or hash.
YOURLS_URL=http://127.0.0.1:8090

# Signature token from the YOURLS admin tools page. Sent in the POST body.
# YOURLS_SIGNATURE=

# Optional. md5, sha256, sha384, or sha512. When set, the connector sends
# timestamp plus hash(timestamp + signature) instead of the raw token.
# YOURLS_SIGNATURE_HASH=sha256

# Username and password. Set together when YOURLS_SIGNATURE is unset.
# YOURLS_USERNAME=admin
# YOURLS_PASSWORD=

# Must be the literal true before a confirmed write is sent.
YOURLS_ALLOW_WRITES=false

# Comma list of toolsets, or all. Default is meta,stats,links.
# YOURLS_TOOLSETS=meta,stats,links

YOURLS_PER_MINUTE=30
YOURLS_CACHE_TTL_SEC=60
YOURLS_TIMEOUT_MS=20000
YOURLS_CONTACT=you@example.com

MCP_TRANSPORT=stdio
PORT=3000
